<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process is starting, with the OS's light setting.
         The background is the app's own page colour rather than the platform
         default, so the splash and the first Flutter frame are the same
         colour and the screen does not flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Draw behind the system bars. The Flutter surface then paints the
             page colour all the way to the edges of the display instead of
             leaving a grey band where the status bar is. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The window once the process has started: Flutter paints this area. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/elara_page_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
